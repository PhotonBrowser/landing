---
import "../styles/global.css";
import { ChevronRight } from "lucide-react";
import BackgroundShader from "../components/BackgroundShader";
import RainOverlay from "../components/RainOverlay";
import StormAudio from "../components/StormAudio";
import WaitlistButton from "../components/WaitlistButton";
import ClickSound from "../components/ClickSound.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Photon is a modern browser powered by Ladybird, an independent browser engine." />
		<meta name="theme-color" content="#76b4fb" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Photon Browser" />
		<meta property="og:description" content="A modern browser powered by an independent engine." />
		<meta property="og:url" content={`${Astro.url.origin}${Astro.url.pathname}`} />
		<meta property="og:image" content={`${Astro.url.origin}/brand-kit/social/og-image.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Photon Browser logo" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Photon Browser" />
		<meta name="twitter:description" content="A modern browser powered by an independent engine." />
		<meta name="twitter:image" content={`${Astro.url.origin}/brand-kit/social/og-image.png`} />
		<title>Photon Browser</title>
	</head>
	<body class="storm-mode storm-active" data-weather="storm">
		<div class="site-loader" id="site-loader" role="status" aria-live="polite" aria-label="Loading Photon">
			<div class="loader-core">
				<div class="loader-mark" aria-hidden="true">
					<div class="loader-mark-base"></div>
					<div class="loader-mark-fill" id="loader-mark-fill"></div>
				</div>
				<div class="loader-track" aria-hidden="true"><span id="loader-progress"></span></div>
				<div class="loader-meta"><span id="loader-status">Loading</span><span id="loader-percent" aria-hidden="true">00%</span></div>
			</div>
		</div>
		<main class="page">
			<div class="hero-sticky" id="top">
				<section class="cloud-card" aria-label="Photon introduction">
					<BackgroundShader client:load />
					<RainOverlay client:load />
					<ClickSound />
					<StormAudio client:load />
				</section>
				<div class="hero-content">
					<a class="badge" href="https://ladybird.org" target="_blank" rel="noreferrer">
						Built on Ladybird <ChevronRight size={13} aria-hidden="true" />
					</a>
					<h1>Meet Photon.</h1>
					<p class="hero-copy">A modern browser powered by an independent engine.</p>
					<div id="waitlist"><WaitlistButton client:load /></div>
				</div>
				<div class="scroll-indicator" aria-hidden="true">
					<span class="scroll-label">Scroll</span>
					<span class="scroll-line"></span>
				</div>
			</div>
			<div class="hero-morph-runway" aria-hidden="true"></div>
			<nav class="site-nav" aria-label="Main navigation">
				<a class="brand" href="/" aria-label="Photon home">
					<img class="logo" src="/brand-kit/logo/logo.svg" alt="" />
					<span>Photon</span>
				</a>
				<div class="nav-links">
					<a href="#about">About</a>
					<a href="https://github.com/LadybirdBrowser/ladybird" target="_blank" rel="noreferrer">GitHub</a>
				</div>
			</nav>

			<section class="content-section" id="about" aria-labelledby="about-title">
				<div class="content-section-inner">
					<div class="about-copy">
						<h2 id="about-title">Photon is built on Ladybird, an independent browser engine.</h2>
						<div>
							<p>We’re building Photon to bring Ladybird to everyday browsing and give people another browser engine to choose from.</p>
						</div>
					</div>
				</div>
			</section>
		</main>
		<script>
			const loader = document.querySelector<HTMLElement>("#site-loader");
			const fill = document.querySelector<HTMLElement>("#loader-mark-fill");
			const progressBar = document.querySelector<HTMLElement>("#loader-progress");
			const percentLabel = document.querySelector<HTMLElement>("#loader-percent");
			const statusLabel = document.querySelector<HTMLElement>("#loader-status");
			const ready = new Set<string>();
			const loaderReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			const connection = (navigator as Navigator & { connection?: { effectiveType?: string; saveData?: boolean } }).connection;
			const skipRainWait = loaderReduceMotion.matches || connection?.saveData === true || ["slow-2g", "2g"].includes(connection?.effectiveType ?? "");
			const required = skipRainWait ? ["page", "fonts", "images", "shader"] : ["page", "fonts", "images", "shader", "rain"];
			let progress = 0;
			let targetProgress = 0;
			let milestoneAt = performance.now();
			let finished = false;
			const updateProgress = () => {
				milestoneAt = performance.now();
				targetProgress = Math.max(targetProgress, Math.min(96, Math.round((ready.size / required.length) * 96)));
				if (required.every((item) => ready.has(item)) && !finished) {
					finished = true;
					if (statusLabel) statusLabel.textContent = "Welcome to Photon";
					targetProgress = 100;
					window.setTimeout(() => {
						loader?.classList.add("site-loader--leaving");
						document.body.classList.add("site-loaded");
						window.setTimeout(() => loader?.remove(), 1100);
					}, loaderReduceMotion.matches ? 0 : 420);
				}
			};
			const animateProgress = () => {
				if (!loader?.isConnected) return;
				if (!loaderReduceMotion.matches && !finished) {
					const coast = Math.min(7, Math.max(0, performance.now() - milestoneAt) * 0.0014);
					targetProgress = Math.min(94, Math.max(targetProgress, Math.floor((ready.size / required.length) * 96 + coast)));
				}
				if (loaderReduceMotion.matches) progress = targetProgress;
				else progress += (targetProgress - progress) * 0.065;
				if (Math.abs(targetProgress - progress) < 0.12) progress = targetProgress;
				if (progressBar) progressBar.style.transform = `scaleX(${progress / 100})`;
				if (fill) fill.style.clipPath = `inset(${100 - progress}% 0 0)`;
				if (percentLabel) percentLabel.textContent = `${String(Math.floor(progress)).padStart(2, "0")}%`;
				window.requestAnimationFrame(animateProgress);
			};
			window.requestAnimationFrame(animateProgress);
			const markReady = (name: string) => { ready.add(name); updateProgress(); };
			window.addEventListener("photon:shader-ready", () => markReady("shader"), { once: true });
			if (!skipRainWait) window.addEventListener("photon:rain-ready", () => markReady("rain"), { once: true });
			const loadPageAssets = async () => {
				const logo = new Image();
				logo.src = "/brand-kit/logo/logo-black.svg";
				await Promise.allSettled([...Array.from(document.images, (image) => image.decode()), logo.decode()]);
				markReady("images");
				await document.fonts.ready;
				markReady("fonts");
				if (document.readyState === "complete") markReady("page");
				else window.addEventListener("load", () => markReady("page"), { once: true });
			};
			void loadPageAssets();
			window.setTimeout(() => { required.filter((item) => !ready.has(item)).forEach(markReady); }, 9000);

			import { createTimeline } from "animejs";

			const frame = document.querySelector<HTMLElement>(".hero-sticky");
			const card = document.querySelector<HTMLElement>(".cloud-card");
			const morphRunway = document.querySelector<HTMLElement>(".hero-morph-runway");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			const siteNav = document.querySelector<HTMLElement>(".site-nav");
			const initialNavInset = frame ? Number.parseFloat(getComputedStyle(frame).paddingTop) : 0;

			if (morphRunway && frame && card && !reduceMotion.matches) {
				const morph = createTimeline({
					autoplay: false,
					defaults: { duration: 1000, ease: "linear" },
				})
					.add(frame, { padding: 0 }, 0)
					.add(card, { borderRadius: 0, borderWidth: 0 }, 0);

				let frameRequest = 0;
				let morphStart = 0;
				let morphDistance = 1;
				const measureMorph = () => {
					const runwayBounds = morphRunway.getBoundingClientRect();
					morphStart = window.scrollY + runwayBounds.top - window.innerHeight;
					morphDistance = Math.max(1, morphRunway.offsetHeight);
				};
				const updateMorph = () => {
					const progress = Math.min(1, Math.max(0, (window.scrollY - morphStart) / morphDistance));
					morph.seek(morph.duration * progress);
					const navInset = initialNavInset * (1 - progress);
					siteNav?.style.setProperty("--nav-inset", `${navInset}px`);
				};
				const onResize = () => {
					measureMorph();
					queueMorphUpdate();
				};
				const queueMorphUpdate = () => {
					if (frameRequest) return;
					frameRequest = window.requestAnimationFrame(() => {
						frameRequest = 0;
						updateMorph();
					});
				};

				window.addEventListener("scroll", queueMorphUpdate, { passive: true });
				window.addEventListener("resize", onResize, { passive: true });
				measureMorph();
				updateMorph();
			} else if (frame && card) {
				frame.style.padding = "0px";
				card.style.borderRadius = "0px";
				card.style.borderWidth = "0px";
				siteNav?.style.setProperty("--nav-inset", "0px");
			}
		</script>
	</body>
</html>
