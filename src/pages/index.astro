---
import "../styles/global.css";
import { ChevronRight } from "lucide-react";
import WaitlistButton from "../components/WaitlistButton";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Cloud Card</title>
	</head>
	<body>
		<main class="page">
			<section class="cloud-card" aria-label="Clouds">
				<nav class="site-nav" aria-label="Main navigation">
					<a class="brand" href="/" aria-label="Photon home">
						<img class="logo" src="/brand-kit/logo/logo.svg" alt="" />
						<span>Photon</span>
					</a>
					<div class="nav-links">
						<a href="#about">About</a>
						<a href="#roadmap">Roadmap</a>
						<a href="https://github.com/LadybirdBrowser/ladybird" target="_blank" rel="noreferrer">GitHub</a>
					</div>
					<a class="nav-cta" href="#waitlist">Join the Waitlist</a>
				</nav>
				<div class="hero-content">
					<div class="badge">Built on Ladybird <ChevronRight size={13} aria-hidden="true" /></div>
					<h1>Meet Photon.</h1>
					<p class="hero-copy">A modern browser powered by an independent engine.</p>
					<div id="waitlist"><WaitlistButton client:load /></div>
				</div>
			</section>
		</main>
	</body>
</html>
